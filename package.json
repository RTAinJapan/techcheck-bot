{
  "name": "techcheck-bot",
  "version": "0.1.0",
  "private": true,
  "description": "配信テスト (techcheck) を進める Discord bot。設計は denpachan の docs/stream-test-automation.md",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1155.0",
    "@aws-sdk/client-mediaconnect": "^3.1155.0",
    "discord.js": "^14.27.0",
    "google-auth-library": "^11.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RTAinJapan/techcheck-bot.git"
  }
}
